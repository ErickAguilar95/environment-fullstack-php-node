# Usuario usado al construir los contenedores de desarrollo.
USER=root
UID=501

# Puerto interno del frontend inicial. Los siguientes proyectos pueden usar
# 8081, 8082, 8083, etc. No es necesario publicarlos en docker-compose.yml.
WELLCOME_WEB_PORT=8080

# Puerto donde se expondra el servicio de NGINX
NGINX_PORT=80

# Referencia para puertos de nuevos frontends:
# FRONTEND_NUEVO_PORT=8081
# FRONTEND_OTRO_PORT=8082
# Estas variables son sólo una bitácora opcional. En app.conf se indica el
# mismo puerto directamente en proxy_pass.
